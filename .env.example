# ──────────────────────────────────────────────────────────────
# HOI / Photographer Backend — Environment Variables
# Copy this file to ".env" and fill in real values.
# Step-by-step setup for each lead source: docs/HUNTER_SOURCES.md
# ──────────────────────────────────────────────────────────────

# Core (required)
PORT=5000
DATABASE_URL="postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require"
JWT_SECRET="<your-jwt-secret>"

# Shared secret the super-admin server uses to save the HOI marketing-site
# content (PUT /api/main-site). Keep it private — never expose to a browser.
SUPERADMIN_SECRET="<your-superadmin-secret>"

# AI scoring (optional but strongly recommended)
# Free tier:  https://console.groq.com/keys
GROQ_API_KEY="gsk_..."

# Meetings email — SMTP (leave blank to log emails to console in dev)
SMTP_HOST=""                    # e.g. smtp.gmail.com
SMTP_PORT="587"                 # 587 for TLS, 465 for SSL
SMTP_USER=""                    # SMTP username
SMTP_PASS=""                    # SMTP password or app password
MAIL_FROM=""                    # e.g. "Studio <studio@example.com>" (defaults to SMTP_USER)


# ══════════════════════════════════════════════════════════════
# AI LEAD HUNTER — SOURCE CONNECTORS
# Every URL / query / API key is read from env. See
# docs/HUNTER_SOURCES.md for step-by-step instructions on how
# to obtain each value.
# ══════════════════════════════════════════════════════════════

# ── UPWORK (RSS, no key needed) ───────────────────────────────
# Option A — paste full RSS URLs (recommended; you control the
# search filters on Upwork):
#   1. Sign in to Upwork (free account is fine)
#   2. Run any search → click the orange RSS icon
#   3. Copy the URL and paste here, comma-separated
UPWORK_RSS_URLS=""
# Option B — keyword-only mode (auto-build URL from each):
UPWORK_QUERIES="wedding photographer,product photography,event photographer,headshot photographer,real estate photography,photo retouching"
# Optional override (rarely needed):
UPWORK_RSS_BASE="https://www.upwork.com/ab/feed/jobs/rss"


# ── FREELANCER (public REST API, no key needed) ──────────────
FREELANCER_QUERIES="wedding photographer,product photography,event photography,real estate photography,headshot photographer,photo retouching"
FREELANCER_LIMIT_PER_QUERY="20"
FREELANCER_API_BASE="https://www.freelancer.com/api/projects/0.1/projects/active/"
# Optional OAuth token for higher rate limits — get one at:
# https://accounts.freelancer.com/settings/develop
FREELANCER_OAUTH_TOKEN=""


# ── GURU (sitemap + schema.org JSON-LD — no API, no key) ─────
# Guru has no RSS and no public API. The connector reads their
# robots.txt-published jobs sitemap and the JobPosting JSON-LD
# on each public job page (same structured data Google reads).
# Works out-of-the-box with NO config. Tunables (all optional):
GURU_SITEMAP_INDEX="https://www.guru.com/sitemap_index_jobs.xml"
GURU_MAX_AGE_DAYS="60"     # ignore jobs older than this
GURU_MAX_JOBS="60"         # cap job pages fetched per run
GURU_CONCURRENCY="5"       # parallel page fetches (be polite)


# ── PEOPLEPERHOUR (RSS only — no public API) ─────────────────
# Visit https://www.peopleperhour.com/freelance-jobs and look
# for the RSS feed URL on each category page.
PPH_RSS_URLS=""


# ── GOOGLE CUSTOM SEARCH JSON API ────────────────────────────
# Free: 100 queries/day. Setup steps:
#   1. https://programmablesearchengine.google.com/  →  Add a
#      new search engine. Set "Sites to search" to the entire
#      web. Copy the "Search engine ID" → GOOGLE_CSE_CX
#   2. https://console.cloud.google.com/apis/library/customsearch.googleapis.com
#      → Enable the API
#   3. https://console.cloud.google.com/apis/credentials
#      → Create API key → GOOGLE_CSE_KEY
GOOGLE_CSE_KEY=""
GOOGLE_CSE_CX=""
GOOGLE_CSE_QUERIES="hiring wedding photographer 2026,looking for product photographer,event photography needed,real estate photographer near me,family photographer wanted"
GOOGLE_CSE_LIMIT="10"


# ── REDDIT (public JSON works without OAuth) ─────────────────
# Subreddits to scan, comma-separated. Examples:
#   forhire, HireAPhotographer, photography_jobs, slavelabour
REDDIT_SUBREDDITS="forhire,HireAPhotographer"
REDDIT_KEYWORDS="photographer,photography,photo shoot,wedding photo,product photo"
REDDIT_LIMIT="30"
REDDIT_USER_AGENT="HOI-LeadHunter/1.0 (by /u/your_reddit_username)"
# Optional OAuth (recommended — raises rate limit from ~60 to
# 100 requests/min). Create a "script" app at:
#   https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
UPWORK_API_KEY=35a97606fecc6e47175e0bcea627c136
UPWORK_API_SECRET=1cde69b0fc9ef1f1