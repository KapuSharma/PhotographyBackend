{
  "name": "photographer-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node -e \"require('kill-port')(5000).catch(()=>{})\"",
    "dev": "nodemon",
    "start": "node src/index.js",
    "seed": "node src/seed.js",
    "seed:admin": "node --env-file=.env src/scripts/seedAdmin.js",
    "seed:plans": "node --env-file=.env src/scripts/seedPlans.js",
    "seed:blog": "node --env-file=.env src/scripts/seedBlog.js",
    "test:isolation": "node --env-file=.env src/scripts/isolationTest.js",
    "build": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "groq-sdk": "^1.1.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^6.9.14",
    "pdfkit": "^0.19.1",
    "pg": "^8.12.0",
    "prisma": "^7.6.0",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "kill-port": "^2.0.1",
    "nodemon": "^3.1.14"
  }
}
